# Peticiones copiables en Thunder Client. Reemplazar preguntaId después del POST.
@baseUrl = http://localhost:8083
@validationUrl = http://localhost:8082
@lifecycleUrl = http://localhost:8084
@preguntaId = PEGAR_ID_DE_CREACION

### 01 - Listar (200)
GET {{baseUrl}}/api/preguntas

### 02 - Crear (201)
POST {{baseUrl}}/api/preguntas
Content-Type: application/json

{
  "enunciado": "¿Qué principio SOLID favorece la extensión sin modificación?",
  "justificacion": "El principio abierto cerrado permite extender comportamiento sin modificar el código existente.",
  "opciones": [
    {
      "texto": "Responsabilidad única",
      "correcta": false
    },
    {
      "texto": "Abierto cerrado",
      "correcta": true
    },
    {
      "texto": "Sustitución de Liskov",
      "correcta": false
    },
    {
      "texto": "Inversión de dependencias",
      "correcta": false
    }
  ]
}

### 03 - Consultar (200)
GET {{baseUrl}}/api/preguntas/{{preguntaId}}

### 04 - Enviar a revisión (202)
POST {{baseUrl}}/api/preguntas/{{preguntaId}}/enviar-revision

### 05 - Comprobante Lifecycle (200)
GET {{lifecycleUrl}}/api/revisiones/{{preguntaId}}

### 06 - Reenvío duplicado (400)
POST {{baseUrl}}/api/preguntas/{{preguntaId}}/enviar-revision

### 07 - Justificación corta (400)
POST {{baseUrl}}/api/preguntas
Content-Type: application/json

{
  "enunciado": "¿Qué principio SOLID favorece la extensión sin modificación?",
  "justificacion": "corta",
  "opciones": [
    {
      "texto": "Responsabilidad única",
      "correcta": false
    },
    {
      "texto": "Abierto cerrado",
      "correcta": true
    },
    {
      "texto": "Sustitución de Liskov",
      "correcta": false
    },
    {
      "texto": "Inversión de dependencias",
      "correcta": false
    }
  ]
}

### 08 - ID inexistente (404)
GET {{baseUrl}}/api/preguntas/00000000-0000-0000-0000-000000000000

### 09 - Validar contenido (200)
POST {{validationUrl}}/api/validaciones/preguntas
Content-Type: application/json

{
  "enunciado": "¿Qué principio SOLID favorece la extensión sin modificación?",
  "justificacion": "El principio abierto cerrado permite extender comportamiento sin modificar el código existente.",
  "opciones": [
    {
      "texto": "Responsabilidad única",
      "correcta": false
    },
    {
      "texto": "Abierto cerrado",
      "correcta": true
    },
    {
      "texto": "Sustitución de Liskov",
      "correcta": false
    },
    {
      "texto": "Inversión de dependencias",
      "correcta": false
    }
  ]
}

### 10 - Validar estructura incompleta (400)
POST {{validationUrl}}/api/validaciones/preguntas
Content-Type: application/json

{
  "enunciado": "Faltan campos"
}

### 11 - Validar límite técnico (400)
POST {{validationUrl}}/api/validaciones/preguntas
Content-Type: application/json

{
  "enunciado": "",
  "justificacion": "El principio abierto cerrado permite extender comportamiento sin modificar el código existente.",
  "opciones": [
    {
      "texto": "Responsabilidad única",
      "correcta": false
    },
    {
      "texto": "Abierto cerrado",
      "correcta": true
    },
    {
      "texto": "Sustitución de Liskov",
      "correcta": false
    },
    {
      "texto": "Inversión de dependencias",
      "correcta": false
    }
  ]
}

